    "# 1. РџР°С‚С‚РµСЂРЅС‹\n",
    "multipack_before_pattern = r'(\\d+)\\s*(?:pcs|sachet(?:s)?)?\\s*[x\\u00d7*]\\s*(\\d+(?:\\.\\d+)?)\\s*(g|kg|ml|l|lt|ltr|pcs)\\b'\n",
