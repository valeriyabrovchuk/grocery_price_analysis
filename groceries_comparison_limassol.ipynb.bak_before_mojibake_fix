    "# NEW: РїР°С‚С‚РµСЂРЅ РґР»СЏ additive size С‚РёРїР° 750+250ml / 750 + 250 ml\n",
    "additive_pattern = r'(\\d+(?:\\.\\d+)?)\\s*\\+\\s*(\\d+(?:\\.\\d+)?)\\s*(g|kg|ml|l|lt|ltr)\\b'\n",
    "\n",
    "# 2. РС‰РµРј СЂР°Р·РЅС‹Рµ С„РѕСЂРјР°С‚С‹\n",
